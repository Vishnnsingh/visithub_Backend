# App
NODE_ENV=development
PORT=5000
APP_NAME=Restrorent
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,https://visithub-frontend.vercel.app

# Security
COOKIE_SECRET=change-this-cookie-secret
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Expo push
EXPO_ACCESS_TOKEN=

# Logs
LOG_LEVEL=info
